# このファイルをコピーして「.env」という名前で保存し、値を入れてください。
# .env は秘密の情報なので、Git には入りません（.gitignore 済み）。

# データベースの接続先（Docker Compose で起動する場合はこのままで OK）
DATABASE_URL="postgresql://pashiri:pashiri@localhost:5432/pashiri?schema=public"

# アプリの URL（Stripe からの戻り先や、Origin チェックに使います）
APP_URL="http://localhost:3000"

# 署名用の秘密の文字列（期限付き URL などに使用）。32文字以上のランダムな文字列にしてください。
# 作り方の例: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET="change-me-to-a-long-random-string-0123456789abcdef"

# 決済モード: mock（偽物の Stripe。キー不要ですぐ試せる） / stripe（Stripe のテストモード）
PAYMENT_MODE="mock"

# Stripe のテストモードのキー（PAYMENT_MODE=stripe のときだけ必要）
# https://dashboard.stripe.com/test/apikeys で確認できます。必ず sk_test_ / pk_test_ で始まるもの。
# sk_live_（本番キー）を入れるとアプリは起動を拒否します。
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
# `stripe listen --forward-to localhost:3000/api/webhooks/stripe` を実行すると表示される whsec_... の値
STRIPE_WEBHOOK_SECRET=""

# レシート画像の保存先（公開フォルダではない場所）
STORAGE_DIR="./storage"
